{
  "name": "ashml",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kubernetes-native GPU machine learning infrastructure platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --watch packages/server/src/index.js",
    "start": "node packages/server/src/index.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "openapi": "node packages/server/scripts/dump-openapi.js",
    "migrate": "npm run migrate --workspace @ashml/server",
    "db:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/local/docker-compose.yml down"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
