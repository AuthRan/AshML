    {
      "id": 7,
      "type": "timeseries",
      "title": "Scheduling latency \u2014 queued until the Kubernetes Job exists",
      "description": "Measured from `queued_at`, not from `created_at`. Those happen in one transaction today, and measuring from the wrong one would start being silently wrong the day admission gains a step between them. Requeued jobs \u2014 nothing fit, or the project is over quota \u2014 are not in this histogram at all; they are in the launch outcomes beside it.",
      "datasource": {
        "type": "prometheus",
        "uid": "ashml-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
