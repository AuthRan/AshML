    {
      "id": 9,
      "type": "timeseries",
      "title": "Seconds per instance, as the pod measured it",
      "description": "Per-image cost, which falls sharply with batch size \u2014 the per-request floor dominates at batch 1. Measured on this cluster: ~270 ms for one image and ~350 ms for eight, against 8.7 ms per image over a 1 000-image run.",
      "datasource": {
        "type": "prometheus",
        "uid": "ashml-prometheus"
