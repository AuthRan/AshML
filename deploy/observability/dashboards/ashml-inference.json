    {
      "id": 11,
      "type": "timeseries",
      "title": "Prediction outcomes",
      "description": "`client_error` is the caller's batch \u2014 the model server refused it and the refusal was relayed verbatim. `server_error` is everything else: an unreachable Service, a pod with no weights, a deployment that was never launched. The split is who has to act, which is the only division a label here can usefully make.\n\nA request naming a deployment that does not exist is in neither: it never reached a pod, and labelling it would mint a series for every name anyone mistypes.",
      "datasource": {
        "type": "prometheus",
        "uid": "ashml-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
