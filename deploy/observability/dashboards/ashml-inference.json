            "type": "prometheus",
            "uid": "ashml-prometheus"
          },
          "expr": "sum by (outcome) (rate(ashml_prediction_duration_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "{{outcome}} /min",
          "range": true,
          "editorMode": "code"
        }
